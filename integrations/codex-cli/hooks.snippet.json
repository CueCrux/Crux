{
  "_comment": "Crux Daemon startup and native apply_patch enforcement for OpenAI Codex CLI. Merge the hooks block into ~/.codex/hooks.json. Tokens are resolved at runtime; no bearer material is stored here.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^apply_patch$",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.local/share/crux/hooks/crux-enforce.sh openai",
            "async": false,
            "timeout": 15
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "CRUX_CODEX_AGENT_NAME=openai python3 /usr/local/share/crux/integrations/codex-cli/hooks/crux-session-start.py",
            "async": false,
            "timeout": 8
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "CRUX_CODEX_AGENT_NAME=openai python3 /usr/local/share/crux/integrations/codex-cli/hooks/crux-session-start.py",
            "async": false,
            "timeout": 8
          }
        ]
      }
    ]
  }
}
