# CoreCrux Community Edition — Configuration
# Copy to .env or export these variables before starting corecruxd.
#
# Required:
#   CORECRUXD_AUTH_MODE — must be set explicitly (no default).
#
# Usage:
#   source config.example.env && ./target/release/corecruxd

# ── Required ───────────────────────────────────────────────────────

# Authentication mode. No default — daemon refuses to start without this.
#   off         — No auth (local dev only)
#   dev_scopes  — Scopes from client headers, no verification (testing only)
#   jwt_hs256   — HS256 JWT verification (small deployments)
#   jwt_jwks    — JWKS/OIDC JWT verification (production)
CORECRUXD_AUTH_MODE=off

# ── Storage ────────────────────────────────────────────────────────

# Data directory for segments, indexes, and control state.
CORECRUXD_DATA_DIR=./data

# Build .ccxi companion indexes at seal time for BM25 retrieval.
# Set to 1 if you plan to use text-search queries.
CORECRUXD_BUILD_CCXI=1

# ── Network ────────────────────────────────────────────────────────

# HTTP API port (also serves /healthz, /readyz, /metrics).
CORECRUXD_HTTP_PORT=14800

# gRPC port for data plane operations (append, replay, export).
# CORECRUXD_GRPC_PORT=4007

# Built-in MCP server port (JSON-RPC over Streamable HTTP).
# CORECRUXD_MCP_PORT=14801

# Bind address. Default: 127.0.0.1 (loopback only).
# Set to 0.0.0.0 for network access — requires jwt_hs256 or jwt_jwks auth mode.
# CORECRUXD_HTTP_HOST=127.0.0.1

# MCP bind address. Default: 127.0.0.1 (loopback only).
# If you bind MCP to a non-loopback address, configure CRUX_AGENT_TOKEN or
# CRUX_AGENT_TOKENS unless you intentionally opt into insecure dev binds.
# CORECRUXD_MCP_HOST=127.0.0.1

# Disable the built-in MCP server entirely.
# CORECRUXD_MCP_ENABLED=true

# ── Logging ────────────────────────────────────────────────────────

# Log format: text (human-readable) or json (structured).
CORECRUX_LOG_FORMAT=text

# Log level: trace, debug, info, warn, error.
# CORECRUXD_LOG_LEVEL=info

# ── Agent / MCP ────────────────────────────────────────────────────

# Agent authentication token. Agents include this as Bearer token.
# Generate with: openssl rand -hex 32
# CRUX_AGENT_TOKEN=

# Optional multi-agent token registry:
#   alice:<token>,bob:<token>
# CRUX_AGENT_TOKENS=

# Stable secret for MCP handoff package authentication.
# If unset, handoff verification keys are process-local and rotate on restart.
# CRUX_MCP_HANDOFF_SECRET=

# ── Debugging ──────────────────────────────────────────────────────

# Include internal topology in error responses (GPU IDs, gRPC addresses).
# CORECRUXD_DEBUG_ERRORS=false

# Default session TTL in seconds. 0 = no expiry.
# CORECRUXD_SESSION_TTL_DEFAULT=0
