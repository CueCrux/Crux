# Crux Daemon — Configuration
# Copy to .env or export these variables before starting corecruxd.
#
# Required:
#   CORECRUXD_AUTH_MODE — must be set explicitly (no default).
#
# Usage:
#   source config.example.env && ./target/release/corecruxd

# ── Required ───────────────────────────────────────────────────────

# Authentication mode. No default — daemon refuses to start without this, and
# refuses to start on an unknown/misspelled value (it never silently falls back
# to dev_scopes). Valid values (exact):
#   off         — No auth (local dev only)
#   dev_scopes  — Scopes from client headers, no verification (testing only)
#   jwt_hs256   — HS256 JWT verification (small deployments)
#   jwt_jwks    — JWKS/OIDC JWT verification (production)
CORECRUXD_AUTH_MODE=off

# HS256 JWT mode requires at least 32 bytes of secret material. Prefer JWKS/OIDC
# for production; use HS256 only for small controlled deployments.
# CORECRUXD_JWT_HS256_SECRET=
# CORECRUXD_ALLOW_WEAK_HS256_SECRET=false

# ── Storage ────────────────────────────────────────────────────────

# Data directory for segments, indexes, and control state.
CORECRUXD_DATA_DIR=./data

# Build .ccxi companion indexes at seal time for BM25 retrieval.
# Set to 1 if you plan to use text-search queries.
CORECRUXD_BUILD_CCXI=1

# Local CPU document ingest and BM25 text search are enabled by default.
# Set either flag to 0 or false to hide its HTTP route with a 404 response.
# CORECRUXD_LOCAL_INGEST=0
# CORECRUXD_QUERY_TEXT_SEARCH=0

# Dataplane graph expansion and time-range queries remain opt-in.
# CORECRUXD_QUERY_GRAPH_EXPAND=1
# CORECRUXD_QUERY_TIME_RANGE=1

# ── Governance-tier local primitives (default off) ───────────────

# Queryable incident reconstruction cases and certified case exports.
# CORECRUXD_FEATURE_INCIDENTS=false

# Legal-hold placement/release and retention/forget/erasure enforcement.
# CORECRUXD_FEATURE_LEGAL_HOLD=false

# Signed audit-bundle export. When no explicit signing key is supplied, the
# daemon generates one once at CORECRUXD_DATA_DIR/audit-export-signing.key,
# stores it mode 0600, and reuses it for a stable, pinnable issuer identity.
# CORECRUXD_FEATURE_AUDIT_EXPORT=false
# CORECRUXD_AUDIT_EXPORT_SIGNING_KEY_B64=
# CORECRUXD_AUDIT_EXPORT_KEY_ID=

# The free local coordination plane remains enabled by default on every tier.
# Set this to false only as an operator opt-out; Governance adds hosted fleet
# aggregation and does not gate /v1/coord/* in the local daemon.
# CORECRUXD_COORD=true

# ── Credit Meter / Comped Wallets ─────────────────────────────────

# Default-off credit-burn test rail for seeded comped wallets.
# Enables POST /v1/credits/spend and spend stamping for successful,
# RCX-verified POST /v1/gpu1/rerank calls. Rerank quotes ride at
# options.credit_quote and cost 3 credits. This does not mint fiat credits,
# call Paddle, or enable production billing.
# CORECRUXD_CREDIT_METER=false

# ── Network ────────────────────────────────────────────────────────

# HTTP API port (also serves /healthz, /readyz, /metrics).
CORECRUXD_HTTP_PORT=14800

# gRPC port for data plane operations (append, replay, export).
# CORECRUXD_GRPC_PORT=4007

# Built-in MCP server port (JSON-RPC over Streamable HTTP).
# CORECRUXD_MCP_PORT=14801

# Bind address. Default: 127.0.0.1 (loopback only).
# Set to 0.0.0.0 for network access — requires jwt_hs256 or jwt_jwks auth mode.
# CORECRUXD_HTTP_HOST=127.0.0.1

# MCP bind address. Default: 127.0.0.1 (loopback only).
# If you bind MCP to a non-loopback address, configure CRUX_AGENT_TOKEN or
# CRUX_AGENT_TOKENS unless you intentionally opt into insecure dev binds.
# CORECRUXD_MCP_HOST=127.0.0.1

# MCP agent bearer tokens (enables MCP auth). Token policy: 32..=256 bytes,
# charset [A-Za-z0-9._~-].
#   CRUX_AGENT_TOKEN=<token>                       (single agent named "default")
#   CRUX_AGENT_TOKENS=alice:<token>,bob:<token>    (multiple named agents)
# Fail-closed: if either var is SET but any token is invalid, the daemon refuses
# to start (a typo must never silently downgrade enforced MCP auth to no-auth).
# CRUX_MCP_ALLOW_EMPTY_AGENT_REGISTRY=1 overrides this for local dev/tests ONLY,
# booting with MCP auth disabled — never set it in production.
# CRUX_MCP_ALLOW_EMPTY_AGENT_REGISTRY=1

# Disable the built-in MCP server entirely.
# CORECRUXD_MCP_ENABLED=true

# Minimal public probes: strip routing (node id, shard map), valve state, and
# readiness check detail from the unauthenticated /healthz and /readyz responses.
# Use when those probes are reachable beyond loopback/internal networks. Full
# diagnostics remain available to admin:read callers. Default: off (full detail).
# CORECRUXD_PUBLIC_PROBES_MINIMAL=1

# ── Logging ────────────────────────────────────────────────────────

# Log format: text (human-readable) or json (structured).
CORECRUX_LOG_FORMAT=text

# Log level: trace, debug, info, warn, error.
# CORECRUXD_LOG_LEVEL=info

# ── Receipt Witness / TSA Preflight ────────────────────────────────
#
# Default-off live witness/TSA settings. Before enabling in production, run:
#   corecruxctl receipts witness-smoke --witness-enabled --witness-provider rekor \
#     --rekor-url "$CORECRUXD_REKOR_URL" \
#     --tsa-enabled --tsa-url "$CORECRUXD_TSA_URL" \
#     --tsa-root-cert "$CORECRUXD_TSA_ROOT_CERT_PATH"
# The daemon also exposes the same local-only check at /v1/witness/smoke.
# These checks do not submit to Rekor or a TSA.
# CORECRUXD_WITNESS_ENABLED=false
# CORECRUXD_WITNESS_PROVIDER=rekor
# CORECRUXD_WITNESS_TIMEOUT_MS=5000
# CORECRUXD_REKOR_URL=https://rekor.sigstore.dev
# CORECRUXD_REKOR_PUBLIC_KEY_PATH=/etc/corecrux/rekor.pub
# CORECRUXD_TSA_ENABLED=false
# CORECRUXD_TSA_URL=https://tsa.example
# CORECRUXD_TSA_ROOT_CERT_PATH=/etc/corecrux/tsa-root.pem
# CORECRUXD_TSA_POLICY_OID=1.2.3.4

# ── Agent / MCP ────────────────────────────────────────────────────

# Agent authentication token. Agents include this as Bearer token. Tokens must
# be 32..=256 ASCII chars from [A-Za-z0-9._~-].
# Generate with: openssl rand -hex 32
# CRUX_AGENT_TOKEN=

# Optional multi-agent token registry:
#   alice:<32-byte-token>,bob:<32-byte-token>
# CRUX_AGENT_TOKENS=

# MCP Streamable HTTP SSE session caps. Defaults: 1024 open streams globally
# and 64 per authenticated agent, or per client IP when no agent is present.
# Set either value to 0 only for emergency rollback/no-cap local debugging.
# CRUX_MCP_SSE_MAX_SESSIONS=1024
# CRUX_MCP_SSE_MAX_SESSIONS_PER_OWNER=64

# Stable secret for MCP handoff package authentication.
# If unset, handoff verification keys are process-local and rotate on restart.
# CRUX_MCP_HANDOFF_SECRET=

# ── Unified login auth rails (crux login) ──────────────────────────
#
# Opt-in daemon-side rails for `corecruxctl login`. Both default OFF, so
# existing deployments are unaffected. Issuance (tailscale + device) mints
# short-lived (≤5 min) HS256 JWTs and therefore requires the daemon to run in
# jwt_hs256 mode (CORECRUXD_AUTH_MODE=jwt_hs256 + CORECRUXD_JWT_HS256_SECRET);
# otherwise the token endpoints return 503.

# Rail 2 — Tailscale identity. Behind `tailscale serve`, the local proxy injects
# a verified `Tailscale-User-Login` header. When enabled, GET /v1/auth/whoami
# echoes the trusted identity and POST /v1/auth/tailscale/token mints a scoped
# JWT for allowlisted identities. Disabled ⇒ 404.
# CORECRUXD_TS_IDENTITY_ENABLED=false
#
# Allowlist mapping verified tailnet logins → principal. Format (comma-separated):
#   login=tenant:scopeA|scopeB
# e.g. alice@example.com=acme:facts:write|query:read,ci@example.com=acme:query:read
# The tenant + scopes here are authoritative; the client cannot influence them (T.1).
# CORECRUXD_TS_IDENTITY_ALLOWLIST=
#
# Extra CIDRs whose peer may present identity headers. Loopback is always trusted
# (the proxy is same-host); set this only if the proxy peer is non-loopback.
# CORECRUXD_TS_TRUSTED_PROXY_CIDRS=

# Rail 3 — Device authorization grant (RFC 8628), the browser/"Claude-style"
# login for callers with no host/env access. When enabled:
#   POST /v1/auth/device/start  → device_code + user_code + verification_uri
#   /activate                   → operator approval page (console admin: admin:write)
#   POST /v1/auth/device/token  → poll → access_token + refresh_token once approved
#   POST /v1/auth/device/refresh / revoke → rotate / revoke the refresh credential
# Disabled ⇒ 404.
# CORECRUXD_DEVICE_GRANT_ENABLED=false

# Unify HTTP + MCP on one credential. When the daemon runs in a JWT mode,
# also accept a registered MCP agent token (CRUX_AGENT_TOKENS) on the HTTP API,
# so a single `corecruxctl login --token <agent-token>` unlocks both :14800 and
# :14801. Default off (HTTP stays JWT-only). Agent tokens carry no claims, so
# every accepted agent token maps to the scope set + tenant below.
# CORECRUXD_HTTP_ACCEPT_AGENT_TOKENS=false
# Scopes granted to an HTTP-accepted agent token (space/comma separated).
# Default: admin:read admin:write facts:write query:read sessions:read sessions:write
# CORECRUXD_AGENT_TOKEN_HTTP_SCOPES=
# Tenant binding for HTTP-accepted agent tokens. `*` = all tenants. Default: *
# CORECRUXD_AGENT_TOKEN_HTTP_TENANT=*

# ── Git Update Checks ──────────────────────────────────────────────

# Compare this checkout against a tracked git branch and expose the cached
# result through /v1/version and the MCP update_status tool.
# Disable only if the node runs outside a git checkout or you do not want
# any background version checks.
# CORECRUXD_UPDATE_CHECK_ENABLED=true

# Tracking branch to compare against.
# CORECRUXD_UPDATE_CHECK_REMOTE=origin
# CORECRUXD_UPDATE_CHECK_REF=main

# Refresh cadence in seconds. Default: 3600.
# CORECRUXD_UPDATE_CHECK_INTERVAL_SECS=3600

# Optional explicit repo root when the service manager starts corecruxd from a
# different working directory.
# CORECRUXD_UPDATE_CHECK_REPO_DIR=/srv/corecrux

# ── Ingress Hardening ──────────────────────────────────────────────
#
# Transport-level protection for the HTTP planes (:14800 API, :14801 MCP).
# All limits accept 0 = disabled/unbounded for emergency rollback without
# a redeploy.

# Maximum accepted HTTP request body in bytes for ordinary routes. Oversized
# requests get a 413 application/problem+json response. Default: 16777216
# (16 MB). Bulk/import routes keep explicit 64 MB route caps.
# CORECRUXD_MAX_REQUEST_BODY_BYTES=16777216

# Hard cap (seconds) on the graceful-shutdown connection drain. After the
# cap, remaining connections are force-closed (logged as a warning).
# Default 30 matches the router-wide request timeout. 0 = drain forever.
# CORECRUXD_SHUTDOWN_DRAIN_SECS=30

# Maximum concurrently-admitted HTTP requests per listener. Excess requests
# are load-shed with a 503 problem+json + Retry-After before any body byte
# is read. Inflight count exported as the corecrux_http_inflight gauge.
# Default: 1024. 0 = no cap.
# CORECRUXD_MAX_INFLIGHT=1024

# Sustained per-client-IP request rate (requests/second). Passport headers
# are validated but are not trusted as pre-auth rate-limit keys. Excess
# requests get a 429 application/problem+json + Retry-After; rejections are
# counted in corecrux_http_rate_limited_total{key_kind}. Default: 300.
# 0 = rate limiting disabled.
# CORECRUXD_RATE_LIMIT_RPS=300

# Per-key burst capacity (token-bucket depth). Values below the sustained
# rate are clamped up to it. Default: 600.
# CORECRUXD_RATE_LIMIT_BURST=600

# Comma-separated CIDRs whose effective client IPs bypass rate limiting
# entirely. Default: loopback only — keeps direct console SPA and local agents
# unthrottled. Forwarded headers from untrusted peers suppress this exemption,
# so an unconfigured same-host reverse proxy gets one shared daemon bucket
# instead of an unlimited loopback bypass. Invalid entries are logged and
# skipped. Empty value = no exemptions.
# CORECRUXD_RATE_LIMIT_EXEMPT_CIDRS=127.0.0.0/8,::1/128

# Comma-separated CIDRs for trusted reverse proxy peers. Only these peers may
# supply Forwarded / X-Forwarded-For for daemon-side client-IP rate limiting.
# If omitted, forwarded headers are ignored. For same-host Caddy/nginx/Envoy,
# set this to 127.0.0.1/32,::1/128 only when the proxy strips inbound
# Forwarded/X-Forwarded-For and rewrites them from the real client address.
# CORECRUXD_TRUSTED_PROXY_CIDRS=

# gRPC plane (:4007) HTTP/2 keep-alive ping interval in seconds. Dead peers
# are reaped instead of holding connections open indefinitely. Default: 30.
# 0 = keep-alive pings disabled.
# CORECRUXD_GRPC_KEEPALIVE_INTERVAL_SECS=30

# How long to wait for a keep-alive ping ack before closing the gRPC
# connection, in seconds. Only meaningful when the interval is non-zero.
# Default: 10.
# CORECRUXD_GRPC_KEEPALIVE_TIMEOUT_SECS=10

# Maximum concurrent HTTP/2 streams per gRPC connection. Transport-level
# protection only — the per-tenant token-bucket throttle remains the
# fairness layer. Default: 1024. 0 = unbounded.
# CORECRUXD_GRPC_MAX_CONCURRENT_STREAMS=1024

# ── Optional Remote Sync / Hosted Platform ────────────────────────

# Crux Daemon works fully in local-only mode by default.
# Set the variables below only if you want this node to sync facts with an
# upstream CoreCrux deployment.

# Enable the background pull/push sync loop.
# CORECRUXD_SYNC_ENABLED=false

# Remote CoreCrux HTTP base URL, for example:
# CORECRUXD_SYNC_REMOTE_URL=https://corecrux.example.com

# Bearer token for the remote sync target.
# CORECRUXD_SYNC_API_KEY=

# Background sync interval in seconds. Default: 300.
# CORECRUXD_SYNC_INTERVAL_SECS=300

# ── Enterprise Customer-Hosted Trust Root ─────────────────────────

# Enable only for customer-hosted Enterprise deployments. When enabled,
# corecruxd validates the trust-root contract at startup before customer
# hosted backends can be used.
# CORECRUXD_ENTERPRISE_ENABLED=false
# CORECRUXD_ENTERPRISE_CUSTOMER_ID=customer-a
# CORECRUXD_ENTERPRISE_BACKEND_ID=customer:cluster-a
# CORECRUXD_ENTERPRISE_TRUST_ROOT_KID=customer-root-a
# CORECRUXD_ENTERPRISE_TRUSTED_ISSUER_KIDS=customer-issuer-a,customer-issuer-b
# CORECRUXD_ENTERPRISE_AIRGAP=true
# CORECRUXD_ENTERPRISE_ALLOW_VAULTCRUX_CROSS_SIGN=false

# ── Embeddings (optional) ──────────────────────────────────────────
#
# Point Crux at any OpenAI-compatible embedding endpoint to enable dense
# vector retrieval on facts. Ollama, vLLM, llama.cpp, TEI, and LiteLLM
# all expose a compatible API.
#
# When set, facts are embedded at store time and queries rank results by
# cosine similarity blended with confidence. When unset, Crux uses
# keyword matching only (no external dependencies).

# Embedding service base URL. Leave unset to disable embeddings.
# CORECRUXD_EMBEDDING_URL=http://localhost:11434

# Embedding console probe blocks private, loopback, link-local, metadata, and
# DNS-rebinding targets unless the target matches CORECRUXD_EMBEDDING_URL.
# Set only for local setup/debugging when probing arbitrary local endpoints.
# CORECRUXD_EMBEDDING_PROBE_ALLOW_LOCAL=false

# Model name to request from the embedding service.
# CORECRUXD_EMBEDDING_MODEL=nomic-embed-text

# ── CoreCrux operator proxy (optional) ─────────────────────────────
#
# Enables /console lane-weight controls to read and write CoreCrux boost
# overlays through this Crux daemon. Vectors stay in CoreCrux; Crux only
# proxies operator-authenticated admin requests.
#
# On Tailscale deployments, use the CoreCrux daemon's Tailscale HTTPS/HTTP
# base URL here. Leave unset to hide the live lane-weight state behind a
# clear "CoreCrux base URL is not configured" console error.
# CORECRUXD_CORECRUX_BASE_URL=http://corecrux:14800
#
# Optional bearer token and passport id forwarded to CoreCrux when its admin
# API is not running in dev-scopes mode.
# CORECRUXD_CORECRUX_ADMIN_TOKEN=
# CORECRUXD_CORECRUX_PASSPORT_ID=

# ── Debugging ──────────────────────────────────────────────────────

# Include internal topology in error responses (GPU IDs, gRPC addresses).
# CORECRUXD_DEBUG_ERRORS=false

# Default session TTL in seconds. 0 = no expiry.
# CORECRUXD_SESSION_TTL_DEFAULT=0
