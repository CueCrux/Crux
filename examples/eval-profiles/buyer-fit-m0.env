# Crux Daemon — Buyer-Fit Evaluation Profile (M0)
#
# Purpose: flip on the shipped-but-hidden capabilities that a heavy
# multi-agent buyer evaluates, so the buyer-fit scorecard (ExecPlan
# crux-daemon-buyer-fit-buildout-2026-07-13) can be run against a single,
# reproducible daemon configuration.
#
# This profile changes ONLY feature-flag defaults. It ships no secrets and
# sets no auth mode — you must still provide CORECRUXD_AUTH_MODE and a data
# dir (see config.example.env, the authoritative flag reference).
#
# Usage:
#   source config.example.env            # base config (auth, storage, network)
#   source examples/eval-profiles/buyer-fit-m0.env   # flip the eval capabilities on
#   ./target/release/corecruxd
#
# Verify the profile booted (all six capabilities report enabled):
#   curl -s localhost:14800/v1/version | jq .capabilities
#   scripts/eval/verify-profile.sh       # machine-checks version + endpoint health
#
# ── The six buyer-fit capabilities ─────────────────────────────────
# Each maps to a knock-out / table-stake axis in the buyer-fit analysis.
# Authoritative flag semantics live in config.example.env; this file only
# sets the eval values.

# #4 Memory + coordination in ONE substrate (work board + handoffs + leases).
# Default is already ON; set explicitly so the profile is self-describing and
# an inherited `CORECRUXD_COORD=0` cannot silently disable it under eval.
CORECRUXD_COORD=1

# #2 Dreams-with-receipts groundwork: consolidation review scheduler.
# Detect-and-surface ONLY (never auto-resolves — safety invariant); surfaces
# stale/contradictory-fact review candidates on an interval.
CORECRUXD_CONSOLIDATION_SCHEDULER=1
# Review cadence in seconds (clamped 60..=86400). 900 = every 15 min for eval
# responsiveness; production default is 3600.
CORECRUXD_CONSOLIDATION_SCHEDULER_INTERVAL_SECS=900

# Provider-neutral context bundle at /v1/context (cross-provider recall the
# buyer mounts from Claude Code + Codex + open models — knock-out #3).
CORECRUXD_CONTEXT_SURFACE=1

# Local folder/file ingest at /v1/local/ingest (setup #7 + the loader the
# tier-packaging plan consumes). Sealed, offline; no external service.
CORECRUXD_LOCAL_INGEST=1

# Live status feed of the work board (part of the memory+coordination
# substrate story, #4).
CORECRUXD_FEATURE_STATUS_FEED=1

# #1 Gated auto-capture (the marquee): session text -> reviewable, receipted,
# born-private candidates at /v1/memory/*. A candidate never reaches recall
# until an explicit promotion; unscored candidates are review-only (fail-closed).
CORECRUXD_AUTO_CAPTURE=1

# Signed, replayable activity log (#5 honest accounting; #6 durable,
# restart-surviving record with a journal).
CORECRUXD_FEATURE_ACTIVITY_LOG=1
# Sign each activity turn so the log is tamper-evident (offline-verifiable).
CORECRUXD_FEATURE_ACTIVITY_SIGN=1
